        "pen",
        "apple"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "And — va. Ikki narsani bog‘laydi: a book and a pen. Oldin bilgan so‘zlaringizdan uzunroq ibora yasaysiz.",
          "teacher_en": "And joins two words or phrases."
        },
        "examples": [
          {
            "english": "a book and a pen"
          },
          {
            "english": "two books and one pen"
          },
          {
            "english": "an apple and a book"
          }
