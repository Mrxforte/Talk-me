<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_voice_surface">

    <ImageButton
        android:id="@+id/proBack"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/pro_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/pro_voice_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:gravity="center"
        android:text="@string/pro_title"
        android:textColor="@color/pro_voice_text"
        android:textSize="@dimen/pro_voice_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/proProgress"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:gravity="center"
        android:textColor="@color/pro_voice_text"
        android:textSize="@dimen/pro_voice_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.feature.pro.ProAvatarView
        android:id="@+id/proAvatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/pro_avatar_girl"
        app:layout_constraintBottom_toBottomOf="@id/proFade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/proBack" />

    <View
        android:id="@+id/proFade"
        android:layout_width="0dp"
        android:layout_height="@dimen/pro_voice_fade"
        android:background="@drawable/bg_pro_avatar_fade"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/proControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/proControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/proReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_pro_reading"
            android:gravity="center"
            android:maxLines="7"
            android:scrollbars="vertical"
            android:padding="@dimen/spacing_medium"
            android:textColor="@color/pro_voice_text"
            android:textSize="@dimen/pro_voice_passage"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.example.core.ui.CosmicWaveformView
            android:id="@+id/proWaveform"
            android:layout_width="@dimen/pro_voice_wave_width"
            android:layout_height="@dimen/pro_voice_wave_height"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/proAction"
            android:layout_width="@dimen/pro_voice_control"
            android:layout_height="@dimen/pro_voice_control"
            android:contentDescription="@string/pro_continue"
            android:insetLeft="@dimen/pro_voice_zero"
            android:insetTop="@dimen/pro_voice_zero"
            android:insetRight="@dimen/pro_voice_zero"
            android:insetBottom="@dimen/pro_voice_zero"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="@dimen/pro_voice_zero"
            android:textColor="@color/pro_voice_surface"
            android:textStyle="bold"
            app:backgroundTint="@color/pro_voice_mint"
            app:cornerRadius="@dimen/pro_voice_control"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/pro_voice_zero"
            app:iconSize="@dimen/pro_voice_icon"
            app:iconTint="@color/pro_voice_surface" />

        <TextView
            android:id="@+id/proStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/pro_preparing"
            android:textColor="@color/pro_voice_text"
            android:textSize="@dimen/pro_voice_title" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
