<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVocabTopic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    android:minHeight="@dimen/touch_target_min"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_card_surface"
    app:cardCornerRadius="@dimen/radius_card_medium"
    app:cardElevation="@dimen/elevation_small"
    app:strokeColor="@color/color_card_outline"
    app:strokeWidth="@dimen/stroke_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large 1-to-1 Topic Cover Image + Mystery Lock Vault Overlay for Locked Topics -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/vocab_card_art_height"
            app:cardBackgroundColor="@color/color_card_surface_subtle"
            app:cardCornerRadius="@dimen/radius_card_compact"
            app:cardElevation="@dimen/elevation_none"
            app:strokeWidth="@dimen/elevation_none">

            <FrameLayout
                android:id="@+id/containerVocabTopicImageFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivVocabTopicArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/stat_memorized_words_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_lesson_conversation_1794310851367" />

                <!-- Mystery Vault Overlay for Locked Major Topics -->
                <FrameLayout
                    android:id="@+id/layoutVocabTopicMysteryOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mystery_mission_vault"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/layoutVocabTopicLockMedallion"
                            android:layout_width="@dimen/vocab_lock_medallion_size"
                            android:layout_height="@dimen/vocab_lock_medallion_size"
                            android:background="@drawable/bg_mystery_lock_circle"
                            android:elevation="@dimen/elevation_card">

                            <ImageView
                                android:layout_width="@dimen/vocab_lock_icon_size"
                                android:layout_height="@dimen/vocab_lock_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@string/topic_status_locked"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/color_on_filled_card" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvVocabTopicMysteryHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:background="@drawable/bg_glass_pill"
                            android:paddingHorizontal="@dimen/spacing_small"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:text="@string/vocab_topic_mystery_preview"
                            android:textColor="@color/color_on_surface"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Bottom-Left Lesson Number Pill -->
                <TextView
                    android:id="@+id/tvVocabTopicOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/spacing_small"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="@string/vocab_topic_order_preview"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Grid Item Bottom Bar Below Image: Title + Subtopics Info + Telegram Green Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVocabTopicTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <!-- Telegram-style Circular / Pill Green Badge -->
                <TextView
                    android:id="@+id/tvVocabTopicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_telegram_green_badge"
                    android:gravity="center"
                    android:minWidth="@dimen/vocab_badge_min_size"
                    android:minHeight="@dimen/vocab_badge_min_size"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:text="@string/vocab_badge_preview"
                    android:textColor="@color/color_on_filled_card"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVocabTopicUzbek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_primary_variant"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVocabTopicSubtopicsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_on_surface_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
