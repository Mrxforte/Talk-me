<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    android:minHeight="@dimen/touch_target_min"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_card_surface"
    app:cardCornerRadius="@dimen/radius_card_medium"
    app:cardElevation="@dimen/elevation_small"
    app:strokeColor="@color/color_card_outline"
    app:strokeWidth="@dimen/stroke_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large Tall Top Image -->
        <ImageView
            android:id="@+id/ivStatCoverImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vocab_card_art_height"
            android:contentDescription="@string/stat_memorized_words_title"
            android:scaleType="centerCrop"
            android:src="@drawable/img_lesson_objects_1794310854481" />

        <!-- 2. Grid Item Bottom Bar Below the Image: Clear Title on Left + Green Telegram Badge on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_card_surface"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingVertical="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvStatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/stat_memorized_words_title"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <!-- Circular/Pill Green Telegram-Style Badge in Grid Item Bottom -->
            <TextView
                android:id="@+id/tvStatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_telegram_green_badge"
                android:gravity="center"
                android:minWidth="@dimen/vocab_badge_min_size"
                android:minHeight="@dimen/vocab_badge_min_size"
                android:paddingHorizontal="@dimen/spacing_small"
                android:text="@string/vocab_badge_preview"
                android:textColor="@color/color_on_filled_card"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Hidden views preserved for ViewBinding compatibility -->
        <ImageView
            android:id="@+id/ivStatIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatValue"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
