<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_medium">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_mistakes"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_display"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/mistakes_intro"
        android:textColor="@color/color_on_surface_secondary"
        android:textSize="@dimen/text_size_body" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openMistakes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/mistakes_open"
            android:textAllCaps="false"
            android:textColor="@color/color_on_surface"
            android:textStyle="bold"
            app:strokeColor="@color/color_card_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resolvedMistakes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/mistakes_done"
            android:textAllCaps="false"
            android:textColor="@color/color_on_surface"
            android:textStyle="bold"
            app:strokeColor="@color/color_card_outline" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/emptyMistakes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/spacing_medium"
        android:text="@string/mistakes_empty_open"
        android:textColor="@color/color_on_surface_secondary"
        android:textSize="@dimen/text_size_body" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mistakeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/spacing_small" />
</LinearLayout>
