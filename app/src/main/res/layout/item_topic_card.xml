<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTimelineRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <!-- Left Timeline Column (Node + Vertical Solid/Dashed Connectors) -->
    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.example.core.ui.VerticalDashedLineView
            android:id="@+id/lineTopConnector"
            android:layout_width="4dp"
            android:layout_height="16dp" />

        <FrameLayout
            android:id="@+id/frameTimelineNode"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_curriculum_node_completed">

            <ImageView
                android:id="@+id/ivTimelineNodeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="Status"
                android:src="@drawable/ic_check_small"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <com.example.core.ui.VerticalDashedLineView
            android:id="@+id/lineBottomConnector"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Right Card Column -->
    <FrameLayout
        android:id="@+id/cardTopic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. COMPLETED / INTRO CARD (Kirish style) -->
        <LinearLayout
            android:id="@+id/layoutCardCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_curriculum_card_completed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="11dp"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="92dp"
                android:layout_height="88dp"
                app:cardBackgroundColor="#152544"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivCompletedThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Kirish"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_curriculum_kirish" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCompletedTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Kirish"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompletedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_curriculum_badge_completed"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="✓ Bajarildi"
                        android:textColor="#4ADE80"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCompletedRangePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_curriculum_pill_dark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="1–10-dars"
                    android:textColor="#CBD5E1"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvCompletedProgressCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="4/10 dars"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp" />

                <ProgressBar
                    android:id="@+id/progressCompletedBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="42"
                    android:progressDrawable="@drawable/bg_curriculum_green_progress" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. ACTIVE / CURRENT MODULE CARD (Salomlashish va tanishuv style) -->
        <LinearLayout
            android:id="@+id/layoutCardActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_curriculum_card_active"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="98dp"
                    android:layout_height="90dp"
                    app:cardBackgroundColor="#152544"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivActiveThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Salomlashish va tanishuv"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_curriculum_salomlashish" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvActiveTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="Salomlashish va\ntanishuv"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvActiveModulePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_curriculum_pill_dark"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:text="A1 • 01-modul"
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dotActive1"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_curriculum_dot_active" />

                        <View
                            android:id="@+id/dotActive2"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_curriculum_dot_inactive" />

                        <View
                            android:id="@+id/dotActive3"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_curriculum_dot_inactive" />

                        <View
                            android:id="@+id/dotActive4"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_curriculum_dot_inactive" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOpenActiveModule"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_curriculum_sky_btn"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOpenActiveModuleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bo‘limni ochish"
                    android:textColor="#081426"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="Open"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. LOCKED COSMIC PURPLE CARD (Keyingi bo'lim with 3D Lock + Star-Burst Animation) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutCardLocked"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:cardBackgroundColor="#1B133A"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#523880"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:id="@+id/containerTopicImageFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivTopicArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Keyingi bo'lim"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_curriculum_locked_card_clean" />

                <!-- Interactive 3D Padlock Medallion that shakes & bursts shooting stars on tap -->
                <FrameLayout
                    android:id="@+id/layoutLockMedallion"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/ivMysteryLockCenter"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/topic_status_locked"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_curriculum_lock_medallion" />
                </FrameLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. FINAL EXAM MILESTONE CARD (A1 yakuniy sinov) -->
        <LinearLayout
            android:id="@+id/layoutCardFinalExam"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_curriculum_card_completed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFinalExamTrophy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Trophy"
                android:scaleType="fitCenter"
                android:src="@drawable/img_curriculum_trophy" />

            <TextView
                android:id="@+id/tvFinalExamTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="A1 yakuniy sinov"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
