<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardOptionContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_assessment_option_default"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Radio outline / selected indicator -->
    <View
        android:id="@+id/viewOptionRadio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_assessment_radio_unselected" />

    <!-- Option Letter label (A., B., C., D.) -->
    <TextView
        android:id="@+id/tvOptionLetter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textColor="@color/color_assessment_green_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Option Text -->
    <TextView
        android:id="@+id/tvOptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/color_on_surface"
        android:textSize="16.5sp"
        android:textStyle="bold" />

    <!-- Right Checkmark / Cross Badge -->
    <ImageView
        android:id="@+id/ivOptionStatusIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Answer status"
        android:src="@drawable/ic_assessment_check_circle"
        android:visibility="gone" />

</LinearLayout>
