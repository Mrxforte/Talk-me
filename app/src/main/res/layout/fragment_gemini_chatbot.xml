<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small">

        <ImageButton
            android:id="@+id/btnChatbotBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chatbot_screen_title"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@drawable/bg_experimental_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/experimental_badge_beta"
                    android:textColor="@color/color_warning"
                    android:textSize="@dimen/text_size_overline"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveConfigSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_slate_subtitle"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditSystemPrompt"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/chatbot_edit_system_cd"
            android:padding="12dp"
            android:src="@drawable/ic_lesson_pencil"
            app:tint="@color/color_primary" />

        <ImageButton
            android:id="@+id/btnClearChat"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/chatbot_clear_chat_cd"
            android:padding="12dp"
            android:src="@drawable/ic_replay_circle"
            app:tint="@color/color_on_surface" />
    </LinearLayout>

    <!-- Model & System Role Selector Strip -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/color_card_surface"
        app:cardCornerRadius="@dimen/radius_card_medium"
        app:cardElevation="@dimen/elevation_small"
        app:strokeColor="@color/color_card_outline"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chatbot_model_label"
                android:textColor="@color/color_slate_subtitle"
                android:textSize="@dimen/text_size_overline"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupModels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/spacing_xs"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModelHydrogen"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/chatbot_model_hydrogen"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModelArgon"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_model_argon"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModelCarbon"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_model_carbon"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModelFlashLite"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_model_flash_lite"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/chatbot_role_label"
                android:textColor="@color/color_slate_subtitle"
                android:textSize="@dimen/text_size_overline"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRoles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/spacing_xs"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoleTutor"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/chatbot_role_tutor"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRolePartner"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_role_partner"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoleGrammar"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_role_grammar"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoleVocab"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_role_vocab"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoleCustom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chatbot_role_custom"
                        app:chipMinTouchTargetSize="@dimen/touch_target_min" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Conversation Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatbotMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_medium" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutChatbotEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_large">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/color_filled_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/color_card_outline"
                app:strokeWidth="@dimen/stroke_thin">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_experimental_chat"
                    app:tint="@color/color_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/chatbot_empty_title"
                android:textColor="@color/color_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/chatbot_empty_desc"
                android:textColor="@color/color_slate_subtitle"
                android:textSize="13.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickPrompt1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/chatbot_quick_prompt_1"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_medium"
                app:strokeColor="@color/color_card_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickPrompt2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/chatbot_quick_prompt_2"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_medium"
                app:strokeColor="@color/color_card_outline" />
        </LinearLayout>
    </FrameLayout>

    <!-- Status / Error Banner -->
    <LinearLayout
        android:id="@+id/layoutChatbotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_small"
        android:background="@drawable/bg_cosmic_live_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressChatbotThinking"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvChatbotStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:textColor="@color/color_error"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <!-- Bottom Message Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_card_surface"
        android:elevation="@dimen/elevation_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="10dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="@dimen/radius_card_large"
            app:boxCornerRadiusBottomStart="@dimen/radius_card_large"
            app:boxCornerRadiusTopEnd="@dimen/radius_card_large"
            app:boxCornerRadiusTopStart="@dimen/radius_card_large">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chatbot_input_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/chatbot_send_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            app:backgroundTint="@color/color_cta_button_bg"
            app:elevation="@dimen/elevation_none"
            app:fabCustomSize="@dimen/touch_target_min"
            app:srcCompat="@drawable/ic_send_arrow"
            app:tint="@color/color_cta_button_text" />
    </LinearLayout>
</LinearLayout>
