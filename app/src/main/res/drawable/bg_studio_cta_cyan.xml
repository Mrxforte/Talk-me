<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/color_studio_cta_start"
                android:centerColor="@color/color_studio_cta_center"
                android:endColor="@color/color_studio_cta_end"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</ripple>
