<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/headerVocabSubtopics"
        layout="@layout/view_screen_header" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReviewAllTopicWords"
        style="@style/Widget.TalkMe.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/vocab_review_all_topic_words" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocabularySubtopics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_large" />

</LinearLayout>
