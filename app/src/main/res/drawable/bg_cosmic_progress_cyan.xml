<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="999dp" />
            <solid android:color="@color/color_cosmic_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="999dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/color_neon_cyan"
                    android:endColor="@color/color_neon_cyan_variant"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
