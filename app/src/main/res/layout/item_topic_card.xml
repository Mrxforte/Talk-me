<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTopic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/color_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large Tall Top Image Container (Uzum.uz Card Style) + Mystery Vault Overlay for Locked Levels -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="182dp"
            app:cardBackgroundColor="@color/color_surface_variant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/containerTopicImageFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivTopicArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/lessons_header_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_lesson_conversation_1794310851367" />

                <!-- Mystery Vault Overlay: Hides locked mission artwork & plays Star Burst Animation on tap -->
                <FrameLayout
                    android:id="@+id/layoutMysteryVaultOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mystery_mission_vault"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:text="✦ ★ ✧"
                        android:textColor="#80FACC15"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:text="✧ ★ ✦"
                        android:textColor="#80F472B6"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/layoutLockMedallion"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_mystery_lock_circle"
                            android:elevation="6dp">

                            <ImageView
                                android:id="@+id/ivMysteryLockCenter"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/topic_status_locked"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvMysteryVaultHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_glass_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="★ MAXFIY MISSIYA ★"
                            android:textColor="#FEF08A"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Top-Right Circular Status Icon -->
                <FrameLayout
                    android:id="@+id/btnTopRightStatusBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_uzum_circle_badge">

                    <ImageView
                        android:id="@+id/ivTopicStatus"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/topic_status_available"
                        android:src="@drawable/ic_check_circle" />
                </FrameLayout>

                <!-- Bottom-Left Compact Lesson Number Pill -->
                <TextView
                    android:id="@+id/tvTopicOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="01-DARS"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. All Text & Details Positioned Cleanly BELOW the Image (Uzum.uz Layout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- English Topic Title (or Mystery Mission Title when Locked) -->
            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Uzbek Topic Subtitle -->
            <TextView
                android:id="@+id/tvTopicUzbek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_primary_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Short Description -->
            <TextView
                android:id="@+id/tvTopicDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />

            <!-- Status & Metric Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTopicProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_uzum_metric_pill"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textColor="#111827"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTopicStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:indicatorColor="@color/color_primary_variant"
                app:trackColor="@color/color_surface_variant"
                app:trackCornerRadius="@dimen/radius_pill"
                app:trackThickness="5dp" />

            <!-- Full-Width Bottom Action Button -->
            <TextView
                android:id="@+id/tvTopicActionCta"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_uzum_action_btn"
                android:gravity="center"
                android:text="Darsni boshlash"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
