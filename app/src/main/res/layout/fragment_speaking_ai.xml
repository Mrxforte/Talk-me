<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <include
        android:id="@+id/headerSpeakingAi"
        layout="@layout/view_screen_header" />

    <!-- PROMINENT 2D ANIMATED AI TUTOR CHARACTER SECTION (~35-40% Screen Height) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiCharacterSection"
        style="@style/Widget.TalkMe.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/color_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Top Status Bar Row: Connection State + Timer + End Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSpeakingConnectionState"
                    style="@style/TextAppearance.TalkMe.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="● Online AI Tutor"
                    android:textColor="@color/color_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpeakingDuration"
                    style="@style/TextAppearance.TalkMe.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEndSpeakingSession"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/speaking_ai_btn_end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="17dp" />
            </LinearLayout>

            <!-- Large 2D Animated AI Character Avatar Frame -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="8dp">

                <!-- Pulsing Aura Background Ring -->
                <View
                    android:id="@+id/ivAiCharacterAura"
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_google_mic_btn"
                    android:alpha="0.3" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiAvatarCircle"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="66dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/ivAiCharacterAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/speaking_ai_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_ai_tutor_avatar_1794304412196" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Topic Title Banner -->
            <TextView
                android:id="@+id/tvSpeakingCurrentTopic"
                style="@style/TextAppearance.TalkMe.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/color_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Conversation Transcript -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSpeakingTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingBottom="8dp" />

    <!-- Bottom Voice & Text Controls (Google Gemini Style) -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TalkMe.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/color_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <EditText
                android:id="@+id/etSpeakingInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/speaking_ai_input_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:textSize="15sp" />

            <!-- Google Round Microphone Button -->
            <ImageButton
                android:id="@+id/btnMicrophoneSpeak"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_google_mic_btn"
                android:contentDescription="@string/speaking_ai_btn_mic"
                android:elevation="2dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendSpeakingText"
                style="@style/Widget.TalkMe.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/speaking_ai_send"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
