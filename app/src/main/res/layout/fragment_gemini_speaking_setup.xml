<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/spacing_small">

        <ImageButton
            android:id="@+id/btnGeminiSetupBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/action_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/speaking_ai_title"
            android:textColor="@color/color_on_surface"
            android:textSize="@dimen/text_size_heading"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/speaking_gemini_setup_subtitle"
        android:textColor="@color/color_on_surface_secondary"
        android:textSize="@dimen/text_size_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/speaking_gemini_level_label"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_subtitle"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_talkme_card"
        android:paddingHorizontal="@dimen/spacing_small"
        android:paddingVertical="4dp">

        <Spinner
            android:id="@+id/levelSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:popupBackground="@color/color_card_surface" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/speaking_gemini_topic_label"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_subtitle"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_talkme_card"
        android:paddingHorizontal="@dimen/spacing_small"
        android:paddingVertical="4dp">

        <Spinner
            android:id="@+id/topicSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:popupBackground="@color/color_card_surface" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:minHeight="@dimen/button_height_primary"
        android:text="@string/speaking_gemini_start_btn"
        android:textAllCaps="false"
        android:textColor="@color/color_cta_button_text"
        android:textSize="@dimen/text_size_button"
        android:textStyle="bold"
        app:backgroundTint="@color/color_cta_button_bg"
        app:cornerRadius="999dp" />
</LinearLayout>