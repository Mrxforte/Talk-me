<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/color_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large Tall Top Image -->
        <ImageView
            android:id="@+id/ivStatCoverImage"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:contentDescription="@string/stat_memorized_words_title"
            android:scaleType="centerCrop"
            android:src="@drawable/img_lesson_objects_1794310854481" />

        <!-- 2. Grid Item Bottom Bar Below the Image: Clear Title on Left + Green Telegram Badge on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvStatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Vocabulary"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Circular/Pill Green Telegram-Style Badge in Grid Item Bottom -->
            <TextView
                android:id="@+id/tvStatBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_telegram_green_badge"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingHorizontal="8dp"
                android:text="+5"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Hidden views preserved for ViewBinding compatibility -->
        <ImageView
            android:id="@+id/ivStatIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatValue"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
