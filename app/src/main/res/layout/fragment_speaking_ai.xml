<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas">

    <!-- 1. FULLSCREEN IMMERSIVE AI CHARACTER STAGE (Video Call Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiCharacterSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/color_app_canvas"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/color_card_outline"
        app:strokeWidth="0dp">

        <com.example.feature.pro.ProAvatarView
            android:id="@+id/ivAiCharacterAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/speaking_ai_title" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Dark gradient overlay for readability of top and bottom controls -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_speaking_scrim_overlay" />

    <!-- 2. FLOATING TOP BAR (Video Call Header: Back + Tutor Dropdown + End) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/action_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Tutor Selector Dropdown Pill (e.g. "Tom ▾" / "Lera ▾") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeakingTutor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:contentDescription="@string/speaking_select_tutor"
                android:text="@string/speaking_select_tutor"
                android:textAllCaps="false"
                android:textColor="@color/color_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_cosmic_card"
                app:strokeColor="@color/color_card_outline"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tvSpeakingCurrentTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/speaking_header_format"
                android:textColor="@color/color_cosmic_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEndSpeakingSession"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/speaking_ai_btn_end"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/color_on_surface" />
    </LinearLayout>

    <!-- 3. BOTTOM MICROPHONE BUTTON (Clean, text-free at bottom center) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:gravity="center">

            <View
                android:id="@+id/ivAiCharacterAura"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_speaking_mic_halo" />

            <ImageButton
                android:id="@+id/btnMicrophoneSpeak"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_speaking_mic_btn"
                android:contentDescription="@string/speaking_ai_btn_mic"
                android:elevation="8dp"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/color_text_on_primary" />
        </FrameLayout>

    </LinearLayout>

    <!-- 4. HIDDEN COMPATIBILITY VIEWS (Updated programmatically by SpeakingAiScreen.kt) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <View
            android:id="@+id/viewTutorStatusDot"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvTutorStageStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ProgressBar
            android:id="@+id/progressSpeakingTurn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvSpeakingTurnCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSpeakingDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSpeakingTranscript"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/cardLiveSpeech"
            android:layout_width="1dp"
            android:layout_height="1dp">

            <com.example.core.ui.CosmicWaveformView
                android:id="@+id/waveformUserLive"
                android:layout_width="1dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tvLiveInterimSpeech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeAuxiliaryControls"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvSpeakingConnectionState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvTapToSpeakLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
