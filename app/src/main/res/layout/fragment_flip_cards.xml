<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <include
        android:id="@+id/headerFlipCards"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Progress Pill Badge -->
        <TextView
            android:id="@+id/tvFlipQueueCounter"
            style="@style/TextAppearance.TalkMe.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="@dimen/spacing_xs"
            android:textColor="@color/color_primary"
            android:textStyle="bold" />

        <!-- 3D Flip Card Container with 4 Rating Buttons Integrated Inside Card -->
        <FrameLayout
            android:id="@+id/flipCardContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flip_card_height">

            <!-- FRONT SIDE: English Word + Audio + Integrated Bottom Rating Dock -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFront"
                style="@style/Widget.TalkMe.Card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/radius_card_large"
                app:cardElevation="@dimen/elevation_hero"
                app:strokeColor="@color/color_primary_light"
                app:strokeWidth="@dimen/stroke_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Card Top Bar: Badge + Audio Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large"
                        android:paddingTop="@dimen/spacing_medium">

                        <TextView
                            style="@style/TextAppearance.TalkMe.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="@dimen/spacing_medium"
                            android:paddingVertical="4dp"
                            android:text="ENGLISH WORD"
                            android:textColor="@color/color_primary"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFrontSpeak"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/lesson_btn_listen"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            app:backgroundTint="@color/color_primary_light"
                            app:cornerRadius="@dimen/radius_pill"
                            app:icon="@drawable/ic_speaker"
                            app:iconSize="18dp"
                            app:iconTint="@color/color_primary" />
                    </LinearLayout>

                    <!-- Tappable Center Content Area to Flip Card -->
                    <LinearLayout
                        android:id="@+id/layoutFrontTapArea"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/spacing_large">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="160dp"
                            android:layout_height="112dp"
                            app:cardBackgroundColor="@color/color_surface_variant"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivFlipWordIllustration"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/flip_cards_title"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_lesson_conversation_1794310851367" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvFrontEnglishWord"
                            style="@style/TextAppearance.TalkMe.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:gravity="center"
                            android:textColor="@color/color_text_primary"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.TalkMe.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="@dimen/spacing_medium"
                            android:paddingVertical="4dp"
                            android:text="@string/flip_card_tap_hint"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider" />

                    <!-- 4 Rating Buttons Inside Bottom of Front Card -->
                    <include
                        android:id="@+id/ratingBarFront"
                        layout="@layout/view_flip_card_rating_bar" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BACK SIDE: Uzbek Meaning + Example Box + Audio + Integrated Bottom Rating Dock -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBack"
                style="@style/Widget.TalkMe.Card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_topic_unlocked_bg"
                app:cardCornerRadius="@dimen/radius_card_large"
                app:cardElevation="@dimen/elevation_hero"
                app:strokeColor="@color/color_secondary"
                app:strokeWidth="@dimen/stroke_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Card Back Top Bar: Badge + Audio Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large"
                        android:paddingTop="@dimen/spacing_medium">

                        <TextView
                            style="@style/TextAppearance.TalkMe.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="@dimen/spacing_medium"
                            android:paddingVertical="4dp"
                            android:text="O'ZBEKCHA MA'NOSI"
                            android:textColor="@color/color_secondary"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackSpeak"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/lesson_btn_listen"
                            android:textColor="@color/color_secondary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            app:backgroundTint="@color/color_secondary_light"
                            app:cornerRadius="@dimen/radius_pill"
                            app:icon="@drawable/ic_speaker"
                            app:iconSize="18dp"
                            app:iconTint="@color/color_secondary" />
                    </LinearLayout>

                    <!-- Tappable Center Content Area on Back Side -->
                    <LinearLayout
                        android:id="@+id/layoutBackTapArea"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/spacing_large">

                        <TextView
                            android:id="@+id/tvBackUzbekMeaning"
                            style="@style/TextAppearance.TalkMe.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/color_secondary"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <!-- Styled Example Sentence Box Inside Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:background="@drawable/bg_flip_example_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">

                            <TextView
                                style="@style/TextAppearance.TalkMe.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MISOL (EXAMPLE)"
                                android:textColor="@color/color_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBackExampleEnglish"
                                style="@style/TextAppearance.TalkMe.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:gravity="center"
                                android:textColor="@color/color_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBackExampleUzbek"
                                style="@style/TextAppearance.TalkMe.BodySecondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xxs"
                                android:gravity="center" />
                        </LinearLayout>

                        <TextView
                            style="@style/TextAppearance.TalkMe.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/flip_card_tap_hint"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider" />

                    <!-- 4 Rating Buttons Inside Bottom of Back Card -->
                    <include
                        android:id="@+id/ratingBarBack"
                        layout="@layout/view_flip_card_rating_bar" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutFlipEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:contentDescription="@string/flip_empty_queue"
                android:src="@drawable/ic_check_circle" />

            <TextView
                style="@style/TextAppearance.TalkMe.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@string/flip_empty_queue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFlipSession"
                style="@style/Widget.TalkMe.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/flip_reset_session" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
