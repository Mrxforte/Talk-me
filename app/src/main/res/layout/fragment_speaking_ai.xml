<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_canvas">

    <LinearLayout
        android:id="@+id/layoutSpeakingSessionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. COSMIC TOP BAR: Back Button + Speaking • Topic + Progress + X/3 + Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_cosmic_circle_btn"
                android:contentDescription="@string/action_back"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/color_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSpeakingCurrentTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/speaking_header_format"
                    android:textColor="@color/color_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progressSpeakingTurn"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="7dp"
                        android:layout_weight="1"
                        android:max="3"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_cosmic_progress_cyan" />

                    <TextView
                        android:id="@+id/tvSpeakingTurnCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="0 / 3"
                        android:textColor="@color/color_cosmic_text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeakingDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="00:00"
                        android:textColor="@color/color_slate_subtitle"
                        android:textSize="11.5sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnEndSpeakingSession"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_cosmic_circle_btn"
                android:contentDescription="@string/speaking_ai_btn_end"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/color_on_surface" />
        </LinearLayout>

        <!-- 2. Animated tutor portrait and speaking state -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiCharacterSection"
            android:layout_width="match_parent"
            android:layout_height="@dimen/speaking_tutor_stage_height"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:clipToOutline="true"
            app:cardBackgroundColor="@color/color_cosmic_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/color_card_outline"
            app:strokeWidth="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.example.feature.pro.ProAvatarView
                    android:id="@+id/ivAiCharacterAvatar"
                    android:layout_marginTop="@dimen/speaking_tutor_control_size"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/speaking_ai_title" />

                <!-- Top-Left Glass Pill: Status Dot + AI Tutor Stage -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_speaking_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp">

                    <View
                        android:id="@+id/viewTutorStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_speaking_green_dot" />

                    <TextView
                        android:id="@+id/tvTutorStageStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/speaking_ai_tutor_badge"
                        android:textColor="@color/color_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeakingTutor"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/speaking_tutor_control_size"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/spacing_small"
                    android:contentDescription="@string/speaking_select_tutor"
                    android:text="@string/speaking_select_tutor"
                    android:textAllCaps="false"
                    android:textColor="@color/color_text_on_primary"
                    app:backgroundTint="@color/color_primary" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. CONVERSATION TRANSCRIPT -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSpeakingTranscript"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="6dp"
            android:paddingBottom="8dp" />

        <!-- 4. LIVE SPEECH CARD ("Siz aytyapsiz") + AUX CONTROLS + GLOWING MIC DOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <!-- Glowing Cyan Live Speech Box -->
            <LinearLayout
                android:id="@+id/cardLiveSpeech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_speaking_live_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- "Siz aytyapsiz" Mini Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_speaking_status_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/speaking_you_say_label"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/color_neon_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/speaking_you_say_label"
                            android:textColor="@color/color_cosmic_text_secondary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.example.core.ui.CosmicWaveformView
                        android:id="@+id/waveformUserLive"
                        android:layout_width="112dp"
                        android:layout_height="26dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveInterimSpeech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/speaking_idle_live_hint"
                    android:textColor="@color/color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Compose Auxiliary Controls: Stop, Mute, Skip TTS, Retry Banner, Keyboard Input -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeAuxiliaryControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Subtle Status Hint -->
            <TextView
                android:id="@+id/tvSpeakingConnectionState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/color_slate_subtitle"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- Large Centered Glowing Blue Microphone Button -->
            <FrameLayout
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginTop="2dp"
                android:gravity="center">

                <View
                    android:id="@+id/ivAiCharacterAura"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_speaking_mic_halo" />

                <ImageButton
                    android:id="@+id/btnMicrophoneSpeak"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_speaking_mic_btn"
                    android:contentDescription="@string/speaking_ai_btn_mic"
                    android:elevation="8dp"
                    android:padding="19dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/color_text_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTapToSpeakLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/speaking_tap_to_speak"
                android:textColor="@color/color_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
