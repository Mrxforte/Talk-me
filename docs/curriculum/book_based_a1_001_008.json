{
  "schema_version": 1,
  "course": "TalkMe A1 book-based starter",
  "source": "G‘apporov and Qosimova, Ingliz tili grammatikasi (2010), adapted pedagogically; examples authored for TalkMe",
  "scope": "Lessons only; no role plays",
  "lessons": [
    {
      "id": "a1-book-001",
      "level": "A1",
      "order": 1,
      "title": "Otlar: atrofimizdagi narsalar",
      "grammar_focus": "Noun",
      "prerequisites": [],
      "estimated_minutes": 7,
      "new_words": [
        "book",
        "pen",
        "phone",
        "apple",
        "bag"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "Ot — odam yoki narsaning nomi. Book — kitob, pen — ruchka. Avval narsani tanishni o‘rganamiz.",
          "teacher_en": "A noun names a person or a thing."
        },
        "examples": [
          {
            "english": "book"
          },
          {
            "english": "pen"
          },
          {
            "english": "apple"
          }
        ],
        "exercises": [
          {
            "skill": "reading",
            "type": "recognition",
            "prompt_uz": "To‘g‘ri ifodani tanlang.",
            "options": [
              "book",
              "pen",
              "phone"
            ],
            "answer": "book"
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "book"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "book",
            "options": [
              "book",
              "pen",
              "phone"
            ],
            "answer": "book"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "book",
            "expected": "book"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun narsalarning inglizcha nomlarini ayta oldingiz. Ertaga bitta narsa haqida gapiramiz."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-002",
      "level": "A1",
      "order": 2,
      "title": "A book, an apple",
      "grammar_focus": "a/an",
      "prerequisites": [
        "a1-book-001"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "book",
        "apple",
        "egg",
        "pen"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "Bitta sanaladigan narsani ilk bor aytganda a yoki an ishlatamiz. A pen, an apple. Tanlash birinchi tovushga bog‘liq: unli tovush oldidan an.",
          "teacher_en": "Use a before a consonant sound and an before a vowel sound."
        },
        "examples": [
          {
            "english": "a book"
          },
          {
            "english": "an apple"
          },
          {
            "english": "an egg"
          }
        ],
        "exercises": [
          {
            "skill": "reading",
            "type": "recognition",
            "prompt_uz": "To‘g‘ri ifodani tanlang.",
            "options": [
              "a book",
              "an apple",
              "a pen"
            ],
            "answer": "an apple"
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "an apple"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "an apple",
            "options": [
              "a book",
              "an apple",
              "a pen"
            ],
            "answer": "an apple"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "an apple",
            "expected": "an apple"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun a book va an apple deyishni o‘rgandingiz. Bu ikki kichik so‘zning tanlovi tovushga bog‘liq."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-003",
      "level": "A1",
      "order": 3,
      "title": "Bir kitob, ikki kitob",
      "grammar_focus": "plural -s",
      "prerequisites": [
        "a1-book-002"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "book",
        "pen",
        "apple"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "Bir dona book, ikki dona books. Ko‘p oddiy sanaladigan otlarga -s qo‘shiladi. Barcha otlar bunday emas; istisnolar keyingi darslarda.",
          "teacher_en": "Most regular countable nouns add -s in the plural."
        },
        "examples": [
          {
            "english": "book → books"
          },
          {
            "english": "pen → pens"
          },
          {
            "english": "apple → apples"
          }
        ],
        "exercises": [
          {
            "skill": "reading",
            "type": "recognition",
            "prompt_uz": "To‘g‘ri ifodani tanlang.",
            "options": [
              "books",
              "pens",
              "apples"
            ],
            "answer": "books"
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "books"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "books",
            "options": [
              "books",
              "pens",
              "apples"
            ],
            "answer": "books"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "books",
            "expected": "books"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun bir va ko‘p narsani farqladingiz. Endi books va pens so‘zlarini taniysiz."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-004",
      "level": "A1",
