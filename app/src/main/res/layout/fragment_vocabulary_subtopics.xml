<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <include
        android:id="@+id/headerVocabSubtopics"
        layout="@layout/view_screen_header" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReviewAllTopicWords"
        style="@style/Widget.TalkMe.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="Barcha mavzu so'zlari (Flip Cards)"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocabularySubtopics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/spacing_large" />

</LinearLayout>
