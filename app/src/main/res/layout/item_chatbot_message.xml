<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChatbotItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_small"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/rowBubbleAlignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBotAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/spacing_small"
            app:cardBackgroundColor="@color/color_filled_card"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/color_card_outline"
            app:strokeWidth="@dimen/stroke_thin">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/chatbot_screen_title"
                android:src="@drawable/ic_experimental_chat"
                app:tint="@color/color_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_speaking_bubble_tutor"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSenderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvModelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@drawable/bg_experimental_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/color_warning"
                    android:textSize="@dimen/text_size_overline"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessageBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.22"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
