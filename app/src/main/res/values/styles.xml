<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.TalkMe.Heading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TalkMe.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TalkMe.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TalkMe.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TalkMe.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TalkMe.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Widget.TalkMe.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card_medium</item>
        <item name="cardElevation">@dimen/elevation_small</item>
        <item name="cardBackgroundColor">@color/color_card_surface</item>
        <item name="strokeColor">@color/color_card_outline</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
    </style>

    <style name="Widget.TalkMe.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/color_cta_button_bg</item>
        <item name="android:textColor">@color/color_cta_button_text</item>
    </style>

    <style name="Widget.TalkMe.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="Widget.TalkMe.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_nav_indicator</item>
    </style>

    <style name="TextAppearance.TalkMe.Hero" parent="TextAppearance.TalkMe.Heading">
        <item name="android:textSize">@dimen/text_size_hero</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.TalkMe.OnImage" parent="TextAppearance.TalkMe.Body">
        <item name="android:textColor">@color/color_on_image</item>
    </style>

    <style name="TextAppearance.TalkMe.OnFilledCard" parent="TextAppearance.TalkMe.Body">
        <item name="android:textColor">@color/color_on_filled_card</item>
    </style>

    <style name="TextAppearance.TalkMe.Overline" parent="TextAppearance.TalkMe.Caption">
        <item name="android:textSize">@dimen/text_size_overline</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.TalkMe.Card.Flat" parent="Widget.TalkMe.Card">
        <item name="cardElevation">@dimen/elevation_none</item>
    </style>

    <style name="Widget.TalkMe.Card.Raised" parent="Widget.TalkMe.Card">
        <item name="cardBackgroundColor">@color/color_card_surface_raised</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.TalkMe.Card.Filled" parent="Widget.TalkMe.Card">
        <item name="cardBackgroundColor">@color/color_filled_card</item>
        <item name="strokeColor">@color/color_filled_card_outline</item>
    </style>

    <style name="Widget.TalkMe.Card.Locked" parent="Widget.TalkMe.Card.Flat">
        <item name="cardBackgroundColor">@color/color_locked_surface</item>
        <item name="strokeColor">@color/color_locked_outline</item>
    </style>

    <style name="Widget.TalkMe.SecondaryButton" parent="Widget.TalkMe.PrimaryButton">
        <item name="backgroundTint">@color/color_card_surface_subtle</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="Widget.TalkMe.CompactButton" parent="Widget.TalkMe.PrimaryButton">
        <item name="android:minHeight">@dimen/button_height_compact</item>
    </style>

    <style name="Widget.TalkMe.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_nav_surface</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TalkMe.BottomNavIndicator</item>
    </style>
</resources>
