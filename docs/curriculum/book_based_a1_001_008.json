              "I am Ali.",
              "You are Ali.",
              "You are here."
            ],
            "answer": "I am Ali."
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "I am Ali."
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "I am Ali.",
            "options": [
              "I am Ali.",
              "You are Ali.",
              "You are here."
            ],
            "answer": "I am Ali."
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "I am Ali.",
            "expected": "I am Ali."
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun I am va you are yordamida kim ekaningizni ayta oldingiz."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-008",
      "level": "A1",
      "order": 8,
      "title": "Are you...?",
      "grammar_focus": "to be question",
      "prerequisites": [
        "a1-book-007"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "are",
        "yes",
        "no"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "Savol berish uchun are ni you dan oldinga o‘tkazamiz: You are Ali. → Are you Ali? Javob: Yes, I am. yoki No, I'm not.",
          "teacher_en": "Move are before you to ask a question."
        },
        "examples": [
          {
            "english": "Are you Ali?"
