              "a book and a pen",
              "two books and one pen",
              "an apple and a book"
            ],
            "answer": "a book and a pen"
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "a book and a pen"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "a book and a pen",
            "options": [
              "a book and a pen",
              "two books and one pen",
              "an apple and a book"
            ],
            "answer": "a book and a pen"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "a book and a pen",
            "expected": "a book and a pen"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun and bilan ikkita narsani birlashtirdingiz. Endi ro‘yxatni inglizcha ayta olasiz."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-006",
      "level": "A1",
      "order": 6,
      "title": "Men va siz: I, you",
      "grammar_focus": "I / you",
      "prerequisites": [
        "a1-book-005"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "I",
        "you"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "I — men. You — sen yoki siz. I o‘zingizga, you esa suhbatdoshingizga tegishli. Hozir faqat kimni bildirayotganini ajratamiz.",
          "teacher_en": "I refers to the speaker; you refers to the listener."
        },
        "examples": [
          {
            "english": "I"
          },
          {
            "english": "you"
          },
          {
            "english": "I → men"
          }
        ],
        "exercises": [
          {
            "skill": "reading",
            "type": "recognition",
            "prompt_uz": "To‘g‘ri ifodani tanlang.",
            "options": [
              "I",
              "you",
              "I"
            ],
            "answer": "you"
          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "you"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "you",
            "options": [
              "I",
              "you",
              "I"
            ],
            "answer": "you"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "you",
            "expected": "you"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun I va you ni ajratishni o‘rgandingiz. Keyingi darsda ular bilan gap tuzamiz."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-007",
      "level": "A1",
      "order": 7,
      "title": "I am / You are",
      "grammar_focus": "to be",
      "prerequisites": [
        "a1-book-006"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "am",
        "are"
      ],
      "stages": {
        "rule": {
          "teacher_uz": "I bilan am, you bilan are ishlatiladi. I am Ali. You are Ali. Inglizchada bu so‘zlarni tashlab ketmaymiz.",
          "teacher_en": "Use am with I and are with you."
        },
        "examples": [
          {
            "english": "I am Ali."
          },
          {
            "english": "You are Ali."
          },
          {
            "english": "I am here."
          }
        ],
        "exercises": [
