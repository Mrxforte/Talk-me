            "answer": "Are you Ali?"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "Are you Ali?",
            "expected": "Are you Ali?"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun savol berishni va qisqa javob qaytarishni mashq qildingiz. Endi oddiy tanishuvga tayyorsiz."
        }
