<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_curriculum_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/spacing_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium">

        <!-- 1. TOP GREETING HEADER (Avatar + Xayrli tong, Azamat + 1 Day Streak) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_xs">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:cardBackgroundColor="@color/color_card_surface"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_card_outline"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/default_user_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_avatar_tutor" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/greeting_morning"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/default_user_name"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_heading"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStreakBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_talkme_secondary_button"
                android:paddingHorizontal="15dp"
                android:paddingVertical="8dp"
                android:text="@string/home_streak_format"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. HERO BANNER — CONTINUE LEARNING -->
        <LinearLayout
            android:id="@+id/cardHeroBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_talkme_filled_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="15dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeroCourseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:text="@string/home_course_label"
                        android:textAllCaps="true"
                        android:textColor="@color/color_on_filled_card"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroTopicName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_default_topic"
                        android:textColor="@color/color_on_filled_card"
                        android:textSize="19.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroSectionName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/curriculum_empty"
                        android:textColor="@color/color_on_filled_card"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    app:cardBackgroundColor="@color/color_card_surface"
                    app:cardCornerRadius="@dimen/radius_card_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_filled_card_outline"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/ivHeroIllustration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/hero_course_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_hero_thumb" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Hero Bottom Row: Progress Bar + 0% completed | Continue Learning > -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:indicatorColor="@color/color_gold_accent"
                        app:trackColor="@color/color_cosmic_track"
                        app:trackCornerRadius="99dp"
                        app:trackThickness="8dp" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_gold_section_bar" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHeroProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/hero_progress_format"
                    android:textColor="@color/color_on_filled_card"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/color_filled_card_outline" />

                <LinearLayout
                    android:id="@+id/btnContinueLearning"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@drawable/bg_talkme_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp">

                    <TextView
                        android:id="@+id/tvContinueLearningLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingMultiplier="0.9"
                        android:text="@string/hero_continue_learning"
                        android:textColor="@color/color_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/home_go"
                        android:src="@drawable/ic_chevron_right_dark"
                        app:tint="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. SECTION HEADER: | Bugungi ko'nikmalar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_gold_section_bar" />

            <TextView
                android:id="@+id/tvHomeSkillsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/home_skills_today"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. SKILLS 2x2 GRID (Speaking, Listening, Writing, Reading) -->
        <!-- Row 1: Speaking & Listening -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Speaking Card (Purple Gradient) -->
            <LinearLayout
                android:id="@+id/cardHomeSpeaking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_skill_speaking_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_skill_speaking" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_skill_speaking_title"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeSpeakingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gapirish"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/btnHomeSpeakingStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_talkme_secondary_button"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start"
                        android:textColor="@color/color_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/home_start"
                        android:src="@drawable/ic_chevron_right_dark"
                        app:tint="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>

            <!-- Listening Card (Teal-Blue Gradient) -->
            <LinearLayout
                android:id="@+id/cardHomeListening"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_skill_listening_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_skill_listening" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_skill_listening_title"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeListeningSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tinglash"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/btnHomeListeningStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_talkme_secondary_button"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start"
                        android:textColor="@color/color_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/home_start"
                        android:src="@drawable/ic_chevron_right_dark"
                        app:tint="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Writing & Reading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Writing Card (Orange-Coral Gradient) -->
            <LinearLayout
                android:id="@+id/cardHomeWriting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_skill_writing_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_skill_writing" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_skill_writing_title"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeWritingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Yozish"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/btnHomeWritingStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_talkme_secondary_button"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start"
                        android:textColor="@color/color_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/home_start"
                        android:src="@drawable/ic_chevron_right_dark"
                        app:tint="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>

            <!-- Reading Card (Royal-Indigo Gradient) -->
            <LinearLayout
                android:id="@+id/cardHomeReading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_skill_reading_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_skill_reading" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_skill_reading_title"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeReadingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="O‘qish"
                    android:textColor="@color/color_on_surface_secondary"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/btnHomeReadingStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_talkme_secondary_button"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start"
                        android:textColor="@color/color_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/home_start"
                        android:src="@drawable/ic_chevron_right_dark"
                        app:tint="@color/color_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. SECTION HEADER: | Learning tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_gold_section_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/home_learning_tools"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 6. LEARNING TOOLS ROW (Vocabulary +36 & Grammar +10) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Vocabulary Tool Card -->
            <LinearLayout
                android:id="@+id/cardHomeVocabulary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/stat_memorized_words_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_tool_vocab" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stat_memorized_words_title"
                        android:textColor="@color/color_on_surface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeVocabBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_talkme_secondary_button"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="+0"
                        android:textColor="@color/color_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grammar Tool Card -->
            <LinearLayout
                android:id="@+id/cardHomeGrammar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_talkme_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/stat_mastered_grammar_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_tool_grammar" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stat_mastered_grammar_title"
                        android:textColor="@color/color_on_surface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeGrammarBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_talkme_secondary_button"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="+0"
                        android:textColor="@color/color_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
