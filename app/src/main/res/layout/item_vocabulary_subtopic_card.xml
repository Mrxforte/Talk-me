<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVocabSubtopic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    android:minHeight="@dimen/touch_target_min"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_card_surface"
    app:cardCornerRadius="@dimen/radius_card_medium"
    app:cardElevation="@dimen/elevation_small"
    app:strokeColor="@color/color_card_outline"
    app:strokeWidth="@dimen/stroke_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large 1-to-1 Sub-topic Artwork on Top -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/vocab_card_art_height"
            app:cardBackgroundColor="@color/color_card_surface_subtle"
            app:cardCornerRadius="@dimen/radius_card_compact"
            app:cardElevation="@dimen/elevation_none"
            app:strokeWidth="@dimen/elevation_none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivVocabSubtopicArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/flip_cards_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_lesson_conversation_1794310851367" />

                <!-- Bottom-Left Sub-topic Index Pill -->
                <TextView
                    android:id="@+id/tvVocabSubtopicOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/spacing_small"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:text="@string/vocab_subtopic_order_preview"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Grid Item Bottom Bar Below Image: Title + Telegram Badge + Words Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVocabSubtopicTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVocabSubtopicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_telegram_green_badge"
                    android:gravity="center"
                    android:minWidth="@dimen/vocab_badge_min_size"
                    android:minHeight="@dimen/vocab_badge_min_size"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:text="@string/vocab_subtopic_badge_preview"
                    android:textColor="@color/color_on_filled_card"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVocabSubtopicUzbek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textColor="@color/color_primary_variant"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <!-- Words Preview Pill Box -->
            <TextView
                android:id="@+id/tvVocabSubtopicWordsPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:background="@drawable/bg_flip_example_box"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="@dimen/spacing_small"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVocabSubtopicCountInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_uzum_metric_pill"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:textColor="@color/color_on_filled_card"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@drawable/bg_uzum_action_btn"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:text="@string/flip_open_cards"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
