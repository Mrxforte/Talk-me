<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_curriculum_screen"
    android:orientation="vertical">

    <!-- Hidden legacy header preserved for binding compatibility -->
    <include
        android:id="@+id/headerExercise"
        layout="@layout/view_screen_header"
        android:visibility="gone" />

    <!-- Shared Studio Cosmic Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnStudioBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/action_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudioTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/studio_title_reading"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressExercise"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="33"
                    android:progressDrawable="@drawable/bg_cosmic_progress_cyan" />

                <TextView
                    android:id="@+id/tvStudioProgressCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="1 / 3"
                    android:textColor="@color/color_cosmic_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnStudioClose"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_cosmic_circle_btn"
            android:contentDescription="@string/speaking_ai_btn_end"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Scrollable Studio Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_medium">

            <!-- Active Studio Content Container -->
            <LinearLayout
                android:id="@+id/layoutActiveQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. READING STUDIO HERO + CHALKBOARD PASSAGE -->
                <LinearLayout
                    android:id="@+id/layoutReadingStudioSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="122dp"
                        app:cardBackgroundColor="@color/color_cosmic_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/color_neon_cyan"
                        app:strokeWidth="1.2dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivReadingHeroBanner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/studio_title_reading"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_reading_studio_hero_1794555591721" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_image_scrim" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chalkboard Passage Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_studio_chalkboard"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tvReadingPassageTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="A new friend"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/color_neon_cyan" />

                        <LinearLayout
                            android:id="@+id/containerReadingLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. WRITING STUDIO DESK HERO + PINNED NOTE + GOALS + SAMPLE -->
                <LinearLayout
                    android:id="@+id/layoutWritingStudioSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        app:cardBackgroundColor="@color/color_cosmic_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/color_cosmic_card_stroke"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/studio_title_writing"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_writing_studio_desk_1794555591194" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Overlapping Pinned Note Card -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="14dp"
                        android:layout_marginTop="-36dp"
                        android:elevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_studio_pinned_note"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingTop="18dp"
                            android:paddingBottom="16dp">

                            <TextView
                                android:id="@+id/tvWritingPinnedPrompt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="@string/studio_title_writing"
                            android:src="@drawable/ic_pushpin_cyan" />
                    </FrameLayout>

                    <!-- Maqsadlar Checklist Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/studio_writing_goals_title"
                            android:src="@drawable/ic_target_bullseye"
                            app:tint="@color/color_neon_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/studio_writing_goals_title"
                            android:textColor="@color/color_cosmic_text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/color_cosmic_divider" />

                        <LinearLayout
                            android:id="@+id/containerWritingGoals"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Namuna Toggle Pill + X/Y gap counter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/btnWritingSampleToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/bg_studio_pill_outline"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/studio_writing_sample_btn"
                                    android:textColor="@color/white"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/ivWritingSampleChevron"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="@string/studio_writing_sample_btn"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/white" />
                            </LinearLayout>
                        </FrameLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvWritingGapCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1/3 gap"
                            android:textColor="@color/color_cosmic_text_secondary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Expandable Sample / Hint Card -->
                    <LinearLayout
                        android:id="@+id/cardWritingSample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_studio_question_card"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvWritingSampleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/color_neon_cyan_variant"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. LISTENING STUDIO EQUALIZER RING + CONTROLS -->
                <LinearLayout
                    android:id="@+id/layoutListeningStudioSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="192dp"
                        android:layout_height="192dp">

                        <com.example.core.ui.CosmicWaveformView
                            android:id="@+id/waveformListeningRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageButton
                            android:id="@+id/btnListeningPlayPause"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center|bottom"
                            android:layout_marginBottom="30dp"
                            android:background="@drawable/bg_speaking_mic_btn"
                            android:contentDescription="@string/studio_listening_play_pause"
                            android:elevation="6dp"
                            android:padding="15dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play_arrow"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvListeningTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="00:00 / 00:08"
                        android:textColor="@color/color_cosmic_text_secondary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressListeningTrack"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_cosmic_progress_cyan" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnListeningReplay"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:background="@drawable/bg_cosmic_circle_btn"
                            android:contentDescription="@string/studio_listening_replay"
                            android:padding="13dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_replay_circle"
                            app:tint="@color/white" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/color_cosmic_divider" />

                        <FrameLayout
                            android:id="@+id/btnListeningSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/bg_studio_pill_outline"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <TextView
                                    android:id="@+id/tvListeningSpeedLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.0×"
                                    android:textColor="@color/white"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="@string/settings_tts_speed_label"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/color_neon_cyan" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. COSMIC QUESTION & OPTIONS CARD -->
                <LinearLayout
                    android:id="@+id/cardStudioQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_studio_question_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvExerciseTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_speaking_status_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/color_neon_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/practice_header_title"
                            android:src="@drawable/ic_question_mark" />

                        <TextView
                            android:id="@+id/tvQuestionPrompt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnPlayQuestionAudio"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:background="@drawable/bg_studio_speaker_btn"
                            android:contentDescription="@string/exercise_play_audio"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_speaker"
                            app:tint="@color/color_neon_cyan" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuestionSubPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/color_cosmic_text_secondary"
                        android:textSize="13.5sp" />

                    <!-- Radio-Ring Options Container -->
                    <LinearLayout
                        android:id="@+id/containerOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 5. GLOWING CYAN WRITTEN INPUT CARD -->
                <FrameLayout
                    android:id="@+id/layoutWritingInputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_studio_input_glow"
                    android:minHeight="170dp"
                    android:padding="16dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etWrittenAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="@string/studio_writing_input_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="120dp"
                        android:paddingBottom="28dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/color_slate_subtitle"
                        android:textCursorDrawable="@null"
                        android:textSize="16.5sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/studio_title_writing"
                        android:src="@drawable/ic_keyboard_outline" />
                </FrameLayout>

                <!-- Hidden legacy TextInputLayout placeholder -->
                <View
                    android:id="@+id/tilWrittenAnswer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- 6. FEEDBACK BANNER -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_cosmic_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_cosmic_card_stroke"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvFeedbackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFeedbackExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/color_cosmic_text_secondary"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SESSION COMPLETE / EMPTY CURRICULUM SUMMARY -->
            <LinearLayout
                android:id="@+id/layoutSessionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:contentDescription="@string/exercise_session_complete_title"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:text="@string/exercise_session_complete_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_heading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSessionSummaryScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:textColor="@color/color_neon_cyan"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFinishSession"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:background="@drawable/bg_studio_cta_cyan"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/studio_btn_finish"
                    android:textColor="@color/white"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Neon-Cyan Studio CTA Button -->
    <TextView
        android:id="@+id/btnSubmitOrNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_studio_cta_cyan"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/studio_btn_check"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
