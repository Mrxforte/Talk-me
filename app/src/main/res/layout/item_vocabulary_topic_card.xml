<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVocabTopic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/color_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Large 1-to-1 Topic Cover Image + Mystery Lock Vault Overlay for Locked Topics -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="168dp"
            app:cardBackgroundColor="@color/color_surface_variant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/containerVocabTopicImageFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivVocabTopicArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/stat_memorized_words_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_lesson_conversation_1794310851367" />

                <!-- Mystery Vault Overlay for Locked Major Topics -->
                <FrameLayout
                    android:id="@+id/layoutVocabTopicMysteryOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mystery_mission_vault"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/layoutVocabTopicLockMedallion"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_mystery_lock_circle"
                            android:elevation="6dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/topic_status_locked"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvVocabTopicMysteryHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_glass_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="★ MAXFIY MAVZU ★"
                            android:textColor="#FEF08A"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Bottom-Left Lesson Number Pill -->
                <TextView
                    android:id="@+id/tvVocabTopicOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="01-MAVZU"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Grid Item Bottom Bar Below Image: Title + Subtopics Info + Telegram Green Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVocabTopicTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Telegram-style Circular / Pill Green Badge -->
                <TextView
                    android:id="@+id/tvVocabTopicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_telegram_green_badge"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:paddingHorizontal="8dp"
                    android:text="+5"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVocabTopicUzbek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_primary_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVocabTopicSubtopicsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
