<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/cardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_tutor"
        android:elevation="2dp"
        android:minWidth="180dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="13dp">

        <!-- Optional Role / Badge Header -->
        <TextView
            android:id="@+id/tvSenderRole"
            style="@style/TextAppearance.TalkMe.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Spoken English Sentence -->
        <TextView
            android:id="@+id/tvMessageContent"
            style="@style/TextAppearance.TalkMe.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <!-- Grammar & Vocabulary Uzbek Feedback / Suggestion -->
        <TextView
            android:id="@+id/tvCorrectionFeedback"
            style="@style/TextAppearance.TalkMe.BodySecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Bottom Action Row: TTS Speaker Button + Replay Label -->
        <LinearLayout
            android:id="@+id/rowMessageActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSpeakMessage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lesson_btn_listen"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speaker" />

            <TextView
                android:id="@+id/tvListenActionLabel"
                style="@style/TextAppearance.TalkMe.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Tinglash (TTS)"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
