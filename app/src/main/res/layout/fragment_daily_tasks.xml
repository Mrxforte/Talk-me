<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Header -->
        <TextView
            android:id="@+id/tvDailyTasksHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/daily_tasks_header_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_heading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDailyTasksHeaderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/daily_tasks_header_subtitle"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <!-- Studied Topic Filter Bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/daily_tasks_topic_filter_label"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDailyTopicTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Today's Daily Plan Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTodayPlanHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/radius_card_large"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="136dp">

                    <ImageView
                        android:id="@+id/ivDailyPlanBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/daily_tasks_header_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_daily_tasks_banner_1794310886631" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_image_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/tvDailyActiveTopicBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mavzu: 1. Introduction — Kirish"
                            android:textColor="@color/color_accent_light"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDailyStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Jarayonda"
                            android:textColor="@color/color_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyCompletedCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:paddingHorizontal="@dimen/spacing_medium"
                        android:paddingBottom="10dp"
                        android:text="Bugungi reja: 2 / 6 bosqich bajarildi"
                        android:textColor="@color/color_text_on_primary"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/tvDailySequentialHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Qoidalar, yangi so'zlar, Reading, Writing, Listening va Speaking mashqlarini birin-ketin yoki alohida bajaring."
                        android:textColor="#D1FAE5"
                        android:textSize="@dimen/text_size_body" />

                    <ProgressBar
                        android:id="@+id/progressDailyTasks"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="33"
                        android:progressTint="@color/color_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartSequentialTasks"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/daily_tasks_btn_sequential"
                        android:textAllCaps="false"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        app:backgroundTint="@color/color_accent"
                        app:cornerRadius="@dimen/radius_medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Topic Mistake Warnings & Error Remediation Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/daily_tasks_warnings_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- Topic Warning Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopicWarningAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            app:cardBackgroundColor="#FEF2F2"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_error"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvTopicWarningBannerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ogohlantirish: Mavzu bo'yicha xatolar aniqlandi!"
                    android:textColor="@color/color_error"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopicWarningBannerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="O'zlashtirilmagan qoida va so'zlar ustida ishlang."
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic Container for Mistake Remediation Cards -->
        <LinearLayout
            android:id="@+id/containerMistakeCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="vertical" />

        <!-- 6 Daily Task Steps (Sequential or Individual) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/daily_tasks_steps_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Har bir bo'limni ketma-ket yoki alohida kirib bajarishingiz mumkin — barchasi kunlik rejaga yoziladi."
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_caption" />

        <LinearLayout
            android:id="@+id/containerDailyTaskSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="vertical" />

        <!-- Daily Plan Tracking History (Completed vs Missed/Incomplete Days) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/daily_tasks_history_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Barcha 6 mashq bajarilsa 'Bajarilgan kun', chalasi qolsa 'Bajarilmagan kun' sifatida saqlanadi."
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_caption" />

        <LinearLayout
            android:id="@+id/containerDailyHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
