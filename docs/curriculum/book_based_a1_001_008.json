          },
          {
            "skill": "writing",
            "type": "copy_then_complete",
            "prompt_uz": "Namunani yozing.",
            "expected": "two books"
          },
          {
            "skill": "listening",
            "type": "listen_and_choose",
            "audio_text": "two books",
            "options": [
              "one book",
              "two books",
              "three pens"
            ],
            "answer": "two books"
          },
          {
            "skill": "speaking",
            "type": "repeat",
            "audio_text": "two books",
            "expected": "two books"
          }
        ],
        "wrap_up": {
          "teacher_uz": "Bugun son va otni birlashtirdingiz: one book, two books. Bu sizga xarid qilishda yordam beradi."
        }
      },
      "status": "editorial_draft_not_app_integrated"
    },
    {
      "id": "a1-book-005",
      "level": "A1",
      "order": 5,
      "title": "Va: and",
      "grammar_focus": "and",
      "prerequisites": [
        "a1-book-004"
      ],
      "estimated_minutes": 7,
      "new_words": [
        "and",
